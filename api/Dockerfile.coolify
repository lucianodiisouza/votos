# Gerado por build-coolify-dockerfile.sh. Não edite à mão.
FROM node:20-alpine
ENV NODE_ENV=production PORT=3000 DATA_DIR=/data
WORKDIR /app
RUN echo '{"type":"module","private":true}' > package.json && npm i --omit=dev web-push@3.6.7 && npm cache clean --force
RUN echo '' | base64 -d | gunzip > server.js
RUN mkdir -p /data && chown -R node:node /data /app
USER node
VOLUME /data
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -qO- http://127.0.0.1:3000/health || exit 1
CMD ["node", "server.js"]
